# Banco de dados
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=changeme
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# IA (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_CHAT=claude-sonnet-5

# Redis / Celery (fila de tarefas em background)
REDIS_URL=redis://localhost:6380/0

# Segurança / rede
# Quantos proxies reversos confiáveis existem na frente do Django (cada
# um reescrevendo X-Forwarded-For, não só repassando). 0 = sem proxy
# (padrão, ex: rodando local via Docker Compose direto). Só aumente em
# produção se souber exatamente a topologia de rede real.
TRUSTED_PROXY_COUNT=0